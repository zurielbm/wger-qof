# Non-secret production defaults for the Dokploy compose stack.
#
# Secrets and instance-specific values (SECRET_KEY, SITE_URL,
# CSRF_TRUSTED_ORIGINS, JWT keys, POSTGRES_PASSWORD, TIME_ZONE) are NOT set
# here — they are injected via the environment blocks in
# docker-compose.dokploy.yml from the Dokploy Environment tab.
#
# Based on https://github.com/wger-project/docker/blob/master/config/prod.env

#
# Django
#
DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
DJANGO_PERFORM_MIGRATIONS=True
DJANGO_COLLECTSTATIC_ON_STARTUP=True
DJANGO_CLEAR_STATIC_FIRST=False
DJANGO_MEDIA_ROOT=/home/wger/media
DJANGO_STATIC_ROOT=/home/wger/static
LOG_LEVEL_PYTHON=INFO
WGER_PORT=3009

# No nginx in front: the app serves its own static files (whitenoise) and
# media uploads (Django view); Dokploy's Traefik proxies straight to gunicorn
DJANGO_SERVE_STATIC_FILES=True
DJANGO_SERVE_MEDIA_FILES=True
# GUNICORN_CMD_ARGS="--workers 3 --threads 2 --worker-tmp-dir /dev/shm"

#
# Database (password comes from the compose environment block)
#
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=wger
DJANGO_DB_USER=wger
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

#
# Cache
#
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient
EXERCISE_CACHE_TTL=2419200

#
# Celery
#
USE_CELERY=True
CELERY_BROKER=redis://cache:6379/2
CELERY_BACKEND=redis://cache:6379/2

#
# Reverse proxy awareness: Cloudflare (tunnel) -> Traefik (Dokploy) -> gunicorn
# Requires Traefik's web entrypoint to trust forwarded headers
# (forwardedHeaders.insecure: true), otherwise Traefik overwrites
# X-Forwarded-Proto with plain http and the mobile app warns about
# misconfigured headers.
#
X_FORWARDED_PROTO_HEADER_SET=True
NUMBER_OF_PROXIES=2

#
# Brute-force login protection
#
AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler
AXES_LOCKOUT_PARAMETERS=ip_address
AXES_IPWARE_PROXY_COUNT=2
AXES_IPWARE_META_PRECEDENCE_ORDER=HTTP_X_FORWARDED_FOR,REMOTE_ADDR

#
# Instance behaviour
#
# Set ALLOW_REGISTRATION=False in the Dokploy Environment tab once your own
# account exists — this is a personal instance on the public internet.
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False
ALLOW_UPLOAD_VIDEOS=True
MIN_ACCOUNT_AGE_TO_TRUST=21

#
# Exercise sync from wger.de (runs via celery beat)
#
WGER_INSTANCE=https://wger.de
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=True
CACHE_API_EXERCISES_CELERY=True
CACHE_API_EXERCISES_CELERY_FORCE_UPDATE=False

#
# Ingredients: fetched on demand as you search instead of syncing the
# multi-GB dump. For a full local copy run once, ideally overnight:
#   docker compose exec web python3 manage.py sync-ingredients
#
SYNC_INGREDIENTS_CELERY=False
DOWNLOAD_INGREDIENTS_FROM=WGER

#
# Email (off by default; configure SMTP to enable password resets)
#
ENABLE_EMAIL=False
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user
# EMAIL_HOST_PASSWORD=password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
FROM_EMAIL=wger Workout Manager <wger@example.com>

#
# JWT token lifetimes (minutes / hours)
#
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=2880
